# =============================================================================
# Copier vers .env, puis renseigner. Voir docs/deploiement.md.
#
# Les trois variables marquees OBLIGATOIRE sont verifiees au demarrage : en
# production, le serveur refuse de demarrer si l une manque ou est invalide.
# =============================================================================

# --- Application ---
# URL canonique : la NFC et le QR Code doivent pointer vers ce domaine (regle metier §11).
# OBLIGATOIRE en production, et en HTTPS.
# ATTENTION : cette URL est gravee dans chaque puce NTAG213. La changer apres
# un premier encodage invalide toutes les cartes deja distribuees.
NEXT_PUBLIC_APP_URL="https://tap.exemple"
# Prefixe court des URL de carte -> https://tap.exemple/c/A7K2M9Q (144 octets NTAG213, §14)
NEXT_PUBLIC_CARD_PATH="/c"

# --- Base de donnees (PostgreSQL) ---
# OBLIGATOIRE.
DATABASE_URL="postgresql://nfc:nfc@localhost:5432/nfc_cards?schema=public"
# Optionnel : connexion directe pour les migrations quand DATABASE_URL passe par un pooler
DIRECT_URL="postgresql://nfc:nfc@localhost:5432/nfc_cards?schema=public"

# --- Auth.js ---
# OBLIGATOIRE, 32 caracteres minimum : openssl rand -base64 32
# Le changer invalide toutes les sessions ouvertes.
AUTH_SECRET="a-generer-avec-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
# Providers OAuth (phase ulterieure, §5.1)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_APPLE_ID=""
# AUTH_APPLE_SECRET=""

# --- Stockage images ---
# Renseigner ces trois valeurs bascule sur Cloudinary : redimensionnement,
# negociation de format et livraison CDN. C est le mode attendu en production.
# Tableau de bord Cloudinary > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Repli sans Cloudinary : ecriture sur disque, hors de public/.
# Ne fonctionne QUE si le systeme de fichiers est persistant - donc pas sur un
# hebergement sans etat comme Vercel.
UPLOAD_DIR=".uploads"

# --- E-mails transactionnels (invitation, reset, verification) ---
EMAIL_FROM="no-reply@tap.exemple"
RESEND_API_KEY=""

# --- Monitoring ---
SENTRY_DSN=""

# --- Compte admin initial (seed) ---
SEED_ADMIN_EMAIL="admin@tap.exemple"
SEED_ADMIN_PASSWORD="ChangeMoi!2026"
